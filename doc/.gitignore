/.quarto/
*.html
*.json
*.js
*.woff
*.css
/ug
/_site
**/*.quarto_ipynb
!*.png
**/ug/
**/ug_pdf/
!/include/*
!/examples/**
.venv
!styles.css
!/doxygen-quarto.css

/include/pdf_download.html

# Generated by link_examples.sh, which runs as a Quarto pre-render script.
# The documentation of each example lives next to its code, somewhere below
# examples/<category>/, and is only mirrored into doc/examples/ as
# a symlink at render time, so neither the symlinks nor the generated include
# list belong in the repository.
/examples/_includes.qmd
/examples/*/**/*.qmd

# The pseudocode extension is vendored, so its assets must survive the *.js and
# *.css rules above.
!/_extensions/**

# Hand written pages that do belong in the repository.
!/examples/*/_intro.qmd
!/examples/forBeginners/cavity_2d.qmd

# The overview table on the Examples page is generated from the exported
# spreadsheet by example_table.sh, another Quarto pre-render script. Only the
# export itself belongs in the repository; Google's editor stylesheet next to
# it is already covered by the *.css rule above and is not needed to build.
/examples/_table_google.qmd
!/_sheet/Table_google.html
